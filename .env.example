# Connection string do Postgres (local: docker compose up -d | prod: Neon)
DATABASE_URL=postgres://futzenha:futzenha@localhost:5433/futzenha

# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessao do admin (qualquer string longa e aleatoria)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Connection string do Postgres (local: docker compose up -d | prod: injetada pela Vercel)
DATABASE_URL=postgres://futzenha:futzenha@localhost:5433/futzenha

# OPCIONAL. Banco dos testes de integracao (npm run test:integration). Sem ela o
# default e o mesmo servidor do compose, banco futzenha_test — criado e migrado
# sozinho pelo global-setup. So aceita localhost, por design.
# TEST_DATABASE_URL=postgres://futzenha:futzenha@localhost:5433/futzenha_test

# OPCIONAL. Banco dos smokes E2E (npm run e2e). Sem ela o default e o mesmo
# servidor do compose, banco futzenha_e2e — criado, migrado e SEMEADO sozinho
# pelo e2e/global-setup.ts.
#
# Banco separado porque o seed apaga todas as tabelas: com a DATABASE_URL de
# cima aqui, rodar E2E custaria o seu banco de desenvolvimento. Por isso as duas
# travas do src/test/db-url.mts — so localhost, e o nome tem que terminar em
# _e2e (que tambem impede apontar para o futzenha_test da integracao).
# E2E_DATABASE_URL=postgres://futzenha:futzenha@localhost:5433/futzenha_e2e

# Admin(s) da plataforma, por username, separados por virgula. Vale como
# chave-mestra: quem esta aqui e admin mesmo que a flag no banco esteja
# desligada — e sem isso um update errado tranca todo mundo do lado de fora de
# um banco sem shell.
#
# O `npm run build` cria a conta de quem esta na lista e ainda nao existe, e
# imprime o link de convite para definir a senha. Esses nomes ficam reservados:
# ninguem consegue escolhe-los ao resgatar um convite, senao bastaria digitar o
# nome certo para sair admin da plataforma.
PLATFORM_ADMIN_USERNAMES=du

# Segredo para assinar o cookie de sessao (obrigatorio)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Login pelo Google (OAuth). Sem os dois, o botao "Entrar com o Google" some e
# so resta usuario e senha. Crie em console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application, e cadastre como redirect URI:
#   http://localhost:3000/api/auth/google/callback
#   https://SEU-DOMINIO/api/auth/google/callback
# Peca apenas os escopos openid/email/profile: sao nao-sensiveis e dispensam a
# verificacao do Google (e por isso o login sai de graca).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio dos convites por email via Resend (resend.com; plano gratis: 3.000/mes,
# 100/dia). Sem a key o envio vira no-op: criar jogador continua funcionando, o
# botao "Reenviar e-mail" some e o link segue entregavel no WhatsApp — igual ao
# login do Google sem credencial. Na Vercel: SO em Production (teste em preview
# nao deve gastar a cota do dia). Crie em resend.com → API Keys, com permissao
# "Sending access", depois de verificar o dominio (ver README).
RESEND_API_KEY=

# OPCIONAL. Remetente dos emails; o default no codigo e
# "FutZenha <convite@futzenha.com.br>". So precisa mudar para testar antes de o
# dominio verificar no Resend — nesse caso use onboarding@resend.dev, que so
# entrega para o email do dono da conta.
# EMAIL_FROM=

# URL publica do site (links de convite, metadados Open Graph e — o que importa
# mais — a redirect URI do login pelo Google, que o Google compara byte a byte).
#
# Local: opcional, o fallback ja e http://localhost:3000.
# Producao: DEFINA (https://futzenha.com.br). Sem ela o site-url.ts deriva de
# VERCEL_PROJECT_PRODUCTION_URL, que costuma estar certo — e "costuma" nao serve
# para uma URI que o Google recusa por um caractere de diferenca.
#
# Como toda NEXT_PUBLIC_*, o valor e embutido em BUILD TIME: mudar o dominio
# depois exige um deploy novo, nao basta editar no painel da Vercel.
#
# Em preview o login pelo Google nao funciona de qualquer forma — por isso as
# GOOGLE_* ficam so em Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPCIONAL. Connection string DIRETA (sem -pooler) para rodar migrations a mao
# contra producao: npm run db:migrate:prod
# DIRECT_DATABASE_URL=

# OPCIONAL em dev, OBRIGATORIO na Vercel. Protege /api/cron/pendencias, que
# fecha as rodadas de avaliacao vencidas. A Vercel envia este valor no header
# Authorization: Bearer. Sem ele definido a rota responde 503.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

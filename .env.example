# Connection string do Postgres (local: docker compose up -d | prod: injetada pela Vercel)
DATABASE_URL=postgres://futzenha:futzenha@localhost:5433/futzenha

# Admin(s) da plataforma, por username, separados por virgula. Vale como
# chave-mestra: quem esta aqui e admin mesmo que a flag no banco esteja
# desligada — e sem isso um update errado tranca todo mundo do lado de fora de
# um banco sem shell.
#
# O `npm run build` cria a conta de quem esta na lista e ainda nao existe, e
# imprime o link de convite para definir a senha. Esses nomes ficam reservados:
# ninguem consegue escolhe-los ao resgatar um convite, senao bastaria digitar o
# nome certo para sair admin da plataforma.
PLATFORM_ADMIN_USERNAMES=du

# Segredo para assinar o cookie de sessao (obrigatorio)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Login pelo Google (OAuth). Sem os dois, o botao "Entrar com o Google" some e
# so resta usuario e senha. Crie em console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application, e cadastre como redirect URI:
#   http://localhost:3000/api/auth/google/callback
#   https://SEU-DOMINIO/api/auth/google/callback
# Peca apenas os escopos openid/email/profile: sao nao-sensiveis e dispensam a
# verificacao do Google (e por isso o login sai de graca).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPCIONAL. URL publica do site (links de convite e metadados Open Graph).
# Na Vercel e derivada do dominio do projeto automaticamente — nao precisa definir la.
#
# ATENCAO com o login pelo Google: o fallback VERCEL_URL muda a cada deploy e
# nunca vai bater com a redirect URI cadastrada. Em producao, defina esta var
# (ou use o dominio de producao do projeto) — em preview, o Google nao funciona.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPCIONAL. Connection string DIRETA (sem -pooler) para rodar migrations a mao
# contra producao: npm run db:migrate:prod
# DIRECT_DATABASE_URL=

# OPCIONAL em dev, OBRIGATORIO na Vercel. Protege /api/cron/pendencias, que
# fecha as rodadas de avaliacao vencidas. A Vercel envia este valor no header
# Authorization: Bearer. Sem ele definido a rota responde 503.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
